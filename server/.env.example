# Server Environment
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL
# Get your free connection string from Neon (https://neon.tech) or Supabase
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Redis Connection (Supports REDIS_URL or Upstash REST credentials)
# Option A: Standard Redis URL
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
# Option B: Upstash Redis REST
UPSTASH_REDIS_REST_URL=https://<endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# JWT Secret for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Configuration for Room Photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
